# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to your deployment platform's environment variables

NODE_ENV=production
PORT=5000

# ⚠️ IMPORTANT: Generate these with: openssl rand -base64 32
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_SECRET_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_SECRET_32_CHARS

JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# MongoDB - Use managed service (MongoDB Atlas, Railway, etc.)
# Format: mongodb+srv://username:password@cluster.mongodb.net/servicehive
MONGO_URI=REPLACE_WITH_YOUR_MONGODB_URI

# Your frontend domain (used for CORS)
CLIENT_URL=https://your-domain.com

# Frontend API path (relative to same domain via Nginx proxy)
VITE_API_URL=/api/v1
